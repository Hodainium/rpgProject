# Copy to infra/.env (gitignored) and change the values.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rpg_db

RABBITMQ_DEFAULT_USER=rpg
RABBITMQ_DEFAULT_PASS=change-me

GF_SECURITY_ADMIN_PASSWORD=change-me

# Server secrets are NOT read from this file. In development they live in dotnet user-secrets
# (cd src/Rpg.GameServerApi; dotnet user-secrets set Seeds:Secret <32+ chars>; dotnet user-secrets set Auth:SigningKey <32+ chars>);
# elsewhere in the environment (Seeds__Secret, Auth__SigningKey).
