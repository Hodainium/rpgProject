# LF everywhere: Linux containers (verifier, entrypoints) and the ruleset_version content hash need byte-identical files.
* text=auto eol=lf

# Windows-only files
*.sln text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.wav binary
*.ogg binary
*.mp3 binary
*.glb binary
*.res binary
*.scn binary
