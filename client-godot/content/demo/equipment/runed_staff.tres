[gd_resource type="Resource" script_class="EquipmentDefinition" format=3]

[ext_resource type="Script" path="res://addons/GodotGAS/effects/gameplay_effect.gd" id="1_eff"]
[ext_resource type="Resource" path="res://content/demo/effects/runed_staff.tres" id="2_effect"]
[ext_resource type="Script" path="res://combat/ability_set.gd" id="3_set"]
[ext_resource type="Script" path="res://combat/equipment_definition.gd" id="4_eq"]

[sub_resource type="Resource" id="Resource_grants"]
script = ExtResource("3_set")
effects = Array[ExtResource("1_eff")]([ExtResource("2_effect")])

[resource]
script = ExtResource("4_eq")
id = &"demo.equipment.runed_staff"
display_name = "Runed Staff"
description = "+30 ATK, +60 max SP, +15% healing."
slot = &"Equipment.Slot.Weapon"
grants = SubResource("Resource_grants")
tags = Array[StringName]([&"Pool.Treasure", &"Pool.Shop", &"Pool.Chest", &"Item.Rarity.Rare", &"Card.Set.Descent"])
price = 8
