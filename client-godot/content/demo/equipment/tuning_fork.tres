[gd_resource type="Resource" script_class="EquipmentDefinition" format=3]

[ext_resource type="Script" path="res://addons/GodotGAS/effects/gameplay_effect.gd" id="1_eff"]
[ext_resource type="Resource" path="res://content/demo/effects/tuning_fork.tres" id="2_fork"]
[ext_resource type="Script" path="res://combat/ability_set.gd" id="3_set"]
[ext_resource type="Script" path="res://combat/equipment_definition.gd" id="4_equip"]

[sub_resource type="Resource" id="Resource_grants"]
script = ExtResource("3_set")
effects = Array[ExtResource("1_eff")]([ExtResource("2_fork")])

[resource]
script = ExtResource("4_equip")
id = &"demo.equipment.tuning_fork"
display_name = "Tuning Fork"
description = "+13% SP gain, +5 SPD."
slot = &"Equipment.Slot.Accessory"
grants = SubResource("Resource_grants")
tags = Array[StringName]([&"Pool.Treasure", &"Pool.Shop", &"Item.Rarity.Rare"])
price = 8
