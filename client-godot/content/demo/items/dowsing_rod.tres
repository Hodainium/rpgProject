[gd_resource type="Resource" script_class="ItemDefinition" format=3]

[ext_resource type="Script" path="res://game/defs/outcomes/run_outcome.gd" id="1_out"]
[ext_resource type="Script" path="res://game/defs/outcomes/reveal_rooms.gd" id="2_reveal"]
[ext_resource type="Script" path="res://game/defs/item_definition.gd" id="3_item"]

[sub_resource type="Resource" id="Resource_reveal"]
script = ExtResource("2_reveal")

[resource]
script = ExtResource("3_item")
id = &"demo.item.dowsing_rod"
display_name = "Dowsing Rod"
description = "Every floor: event rooms show on the map."
tags = Array[StringName]([&"Pool.Treasure", &"Pool.Shop", &"Item.Rarity.Rare"])
price = 7
on_pickup = Array[ExtResource("1_out")]([SubResource("Resource_reveal")])
on_floor_start = Array[ExtResource("1_out")]([SubResource("Resource_reveal")])
