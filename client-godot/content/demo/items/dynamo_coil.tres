[gd_resource type="Resource" script_class="ItemDefinition" format=3]

[ext_resource type="Script" path="res://addons/GodotGAS/effects/gameplay_effect.gd" id="1_eff"]
[ext_resource type="Resource" path="res://content/demo/effects/dynamo_coil.tres" id="2_stat"]
[ext_resource type="Script" path="res://combat/ability_set.gd" id="3_set"]
[ext_resource type="Script" path="res://game/defs/item_definition.gd" id="4_item"]

[sub_resource type="Resource" id="Resource_grants"]
