[gd_resource type="Resource" script_class="EnemyVariant" format=3]

[ext_resource type="Script" path="res://addons/GodotGAS/effects/gameplay_effect.gd" id="1_eff"]
[ext_resource type="Resource" path="res://content/demo/effects/variant_swift.tres" id="2_swift"]
[ext_resource type="Script" path="res://combat/ability_set.gd" id="3_set"]
[ext_resource type="Script" path="res://combat/enemy_variant.gd" id="4_var"]

[sub_resource type="Resource" id="Resource_grants"]
script = ExtResource("3_set")
