[sub_resource type="Resource" id="Resource_lqq4n"]
script = ExtResource("5_31nea")
pages = Array[int]([1, 2])
weights_x100 = Array[int]([100, 100])

[sub_resource type="Resource" id="Resource_by7k5"]
script = ExtResource("2_m0aei")
label = "Take the good one"
outcomes = Array[ExtResource("4_wknld")]([SubResource("Resource_lqq4n")])
tags = Array[StringName]([&"Choice.Gamble", &"Choice.Gain.Armor", &"Choice.Cost.Hp"])

[sub_resource type="Resource" id="Resource_crcrj"]
script = ExtResource("7_q3g6c")
character = ExtResource("6_hk5qq")

[sub_resource type="Resource" id="Resource_eqeqi"]
script = ExtResource("8_4vdr1")
page = 3

[sub_resource type="Resource" id="Resource_o51hu"]
script = ExtResource("2_m0aei")
label = "Brace the rack and take it"
conditions = Array[ExtResource("3_wvbpn")]([SubResource("Resource_crcrj")])
outcomes = Array[ExtResource("4_wknld")]([SubResource("Resource_eqeqi")])
tags = Array[StringName]([&"Choice.Class", &"Choice.Gain.Armor"])
show = 1

[sub_resource type="Resource" id="Resource_7a8f1"]
script = ExtResource("8_4vdr1")
page = 4

[sub_resource type="Resource" id="Resource_govhs"]
script = ExtResource("2_m0aei")
label = "Leave"
outcomes = Array[ExtResource("4_wknld")]([SubResource("Resource_7a8f1")])
tags = Array[StringName]([&"Choice.Leave"])

[sub_resource type="Resource" id="Resource_akmxj"]
script = ExtResource("1_01ryq")
text = "A rack of old arms leans against the wall, one good blade among the rust."
choices = Array[ExtResource("2_m0aei")]([SubResource("Resource_by7k5"), SubResource("Resource_o51hu"), SubResource("Resource_govhs")])

[sub_resource type="Resource" id="Resource_m08qm"]
script = ExtResource("2_m0aei")
label = "Continue"
tags = Array[StringName]([&"Choice.Leave"])

[sub_resource type="Resource" id="Resource_f7hpp"]
script = ExtResource("9_rao5l")
require_all_tags = Array[StringName]([&"Pool.Treasure"])

[sub_resource type="Resource" id="Resource_cpead"]
script = ExtResource("10_4itn6")
query = SubResource("Resource_f7hpp")
prefer_open_slot = true
only_slot = &"Equipment.Slot.Weapon"

[sub_resource type="Resource" id="Resource_e08bm"]
script = ExtResource("12_um5if")
effect = ExtResource("11_c045k")
target = 1
slot = 2

[sub_resource type="Resource" id="Resource_fjc7s"]
script = ExtResource("1_01ryq")
text = "As you pull the blade free the whole rack gives way and crashes onto {member:2}. At least the weapon is yours."
choices = Array[ExtResource("2_m0aei")]([SubResource("Resource_m08qm")])
on_enter = Array[ExtResource("4_wknld")]([SubResource("Resource_cpead"), SubResource("Resource_e08bm")])

[sub_resource type="Resource" id="Resource_ux1ea"]
script = ExtResource("2_m0aei")
label = "Continue"
tags = Array[StringName]([&"Choice.Leave"])

[sub_resource type="Resource" id="Resource_ffbyx"]
script = ExtResource("9_rao5l")
require_all_tags = Array[StringName]([&"Pool.Treasure"])

[sub_resource type="Resource" id="Resource_63my6"]
script = ExtResource("10_4itn6")
query = SubResource("Resource_ffbyx")
prefer_open_slot = true
only_slot = &"Equipment.Slot.Weapon"

[sub_resource type="Resource" id="Resource_iflnv"]
script = ExtResource("1_01ryq")
text = "The rack creaks but holds. You ease the blade out and step back carefully."
choices = Array[ExtResource("2_m0aei")]([SubResource("Resource_ux1ea")])
on_enter = Array[ExtResource("4_wknld")]([SubResource("Resource_63my6")])

[sub_resource type="Resource" id="Resource_gxvnw"]
script = ExtResource("2_m0aei")
label = "Continue"
tags = Array[StringName]([&"Choice.Leave"])

[sub_resource type="Resource" id="Resource_ke5e1"]
script = ExtResource("9_rao5l")
require_all_tags = Array[StringName]([&"Pool.Treasure"])

[sub_resource type="Resource" id="Resource_foap6"]
script = ExtResource("10_4itn6")
query = SubResource("Resource_ke5e1")
prefer_open_slot = true
only_slot = &"Equipment.Slot.Weapon"

[sub_resource type="Resource" id="Resource_yjbpd"]
script = ExtResource("1_01ryq")
text = "The Bulwark sets a shoulder against the rack while the others lift the weapon free. Nothing falls."
choices = Array[ExtResource("2_m0aei")]([SubResource("Resource_gxvnw")])
on_enter = Array[ExtResource("4_wknld")]([SubResource("Resource_foap6")])

[sub_resource type="Resource" id="Resource_y4k5g"]
script = ExtResource("2_m0aei")
label = "Continue"
tags = Array[StringName]([&"Choice.Leave"])

[sub_resource type="Resource" id="Resource_kssmj"]
script = ExtResource("1_01ryq")
text = "Old rust can bite. You leave the rack standing."
choices = Array[ExtResource("2_m0aei")]([SubResource("Resource_y4k5g")])

[resource]
script = ExtResource("13_tc3h2")
