[sub_resource type="Resource" id="Resource_endgo2"]
script = ExtResource("11_endpg")
page = 2

[sub_resource type="Resource" id="Resource_endgo3"]
script = ExtResource("11_endpg")
page = 3

[sub_resource type="Resource" id="Resource_eq2rh"]
script = ExtResource("6_15h5p")
effect = ExtResource("5_cinth")

[sub_resource type="Resource" id="Resource_g115c"]
script = ExtResource("2_h61hg")
label = "Drink (heal 35%)"
tags = Array[StringName]([&"Choice.Gain.Heal"])
outcomes = Array[ExtResource("4_022y5")]([SubResource("Resource_eq2rh"), SubResource("Resource_endgo1")])

[sub_resource type="Resource" id="Resource_85x8c"]
script = ExtResource("7_8c0po")
amount = 10

[sub_resource type="Resource" id="Resource_tmppl"]
script = ExtResource("8_a1jcu")
amount = 10

[sub_resource type="Resource" id="Resource_m3d8b"]
script = ExtResource("6_15h5p")
effect = ExtResource("9_slw73")

[sub_resource type="Resource" id="Resource_k6175"]
script = ExtResource("2_h61hg")
label = "Bathe (10 coins: heal 70%)"
tags = Array[StringName]([&"Choice.Cost.Coins", &"Choice.Gain.Heal"])
conditions = Array[ExtResource("3_8wjl7")]([SubResource("Resource_85x8c")])
outcomes = Array[ExtResource("4_022y5")]([SubResource("Resource_tmppl"), SubResource("Resource_m3d8b"), SubResource("Resource_endgo2")])

[sub_resource type="Resource" id="Resource_8yuaa"]
script = ExtResource("2_h61hg")
label = "Leave"
tags = Array[StringName]([&"Choice.Leave"])
outcomes = Array[ExtResource("4_022y5")]([SubResource("Resource_endgo3")])

[sub_resource type="Resource" id="Resource_7njx7"]
script = ExtResource("1_2ir31")
text = "Warm water bubbles up between the stones."
choices = Array[ExtResource("2_h61hg")]([SubResource("Resource_g115c"), SubResource("Resource_k6175"), SubResource("Resource_8yuaa")])

[sub_resource type="Resource" id="Resource_endcont"]
script = ExtResource("2_h61hg")
label = "Continue"
tags = Array[StringName]([&"Choice.Leave"])

[sub_resource type="Resource" id="Resource_endpage1"]
script = ExtResource("1_2ir31")
text = "The party cups the warm water and drinks. It tastes of stone and iron, and your cuts close as you drink."
choices = Array[ExtResource("2_h61hg")]([SubResource("Resource_endcont")])

[sub_resource type="Resource" id="Resource_endpage2"]
script = ExtResource("1_2ir31")
text = "You drop the coins into the keeper's bowl and sink into the warm pool. By the time you climb out, every ache has melted away."
choices = Array[ExtResource("2_h61hg")]([SubResource("Resource_endcont")])

[sub_resource type="Resource" id="Resource_endpage3"]
script = ExtResource("1_2ir31")
text = "You walk on, the sound of bubbling water fading behind you."
choices = Array[ExtResource("2_h61hg")]([SubResource("Resource_endcont")])

[resource]
script = ExtResource("10_2x0c5")
id = &"demo.event.healing_spring"
display_name = "Healing Spring"
tags = Array[StringName]([&"Event.Demo"])
pages = Array[ExtResource("1_2ir31")]([SubResource("Resource_7njx7"), SubResource("Resource_endpage1"), SubResource("Resource_endpage2"), SubResource("Resource_endpage3")])
