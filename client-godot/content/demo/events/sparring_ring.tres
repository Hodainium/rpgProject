[sub_resource type="Resource" id="Resource_wu05t"]
script = ExtResource("1_gcm7w")
text = "The Warrior steps into the ring and disarms the knight in three moves. He laughs, bows, and spends an hour showing everyone his best tricks."
choices = Array[ExtResource("2_himll")]([SubResource("Resource_ib3os")])
on_enter = Array[ExtResource("4_0dwld")]([SubResource("Resource_0dd2b")])

[sub_resource type="Resource" id="Resource_voefu"]
