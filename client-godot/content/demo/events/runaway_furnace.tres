[sub_resource type="Resource" id="Resource_t5bf7"]
script = ExtResource("5_its1l")
page = 1

[sub_resource type="Resource" id="Resource_2yflf"]
script = ExtResource("2_2jvkf")
label = "Shut it down"
outcomes = Array[ExtResource("4_343ob")]([SubResource("Resource_t5bf7")])
tags = Array[StringName]([&"Choice.Fight", &"Choice.Gain.Keys"])

[sub_resource type="Resource" id="Resource_dvdc5"]
script = ExtResource("7_7asw1")
