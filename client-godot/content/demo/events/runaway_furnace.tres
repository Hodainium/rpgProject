[sub_resource type="Resource" id="Resource_icqym"]
script = ExtResource("2_2jvkf")
label = "Fight!"
outcomes = Array[ExtResource("4_343ob")]([SubResource("Resource_rqcv2")])
tags = Array[StringName]([&"Choice.Fight", &"Choice.Gain.Keys"])

[sub_resource type="Resource" id="Resource_lfdhk"]
script = ExtResource("1_s8yq1")
text = "You reach for the bellows. The keepers turn as one, molten tools in hand!"
choices = Array[ExtResource("2_2jvkf")]([SubResource("Resource_icqym")])

[sub_resource type="Resource" id="Resource_ishql"]
script = ExtResource("2_2jvkf")
label = "Continue"
tags = Array[StringName]([&"Choice.Leave"])

[sub_resource type="Resource" id="Resource_x0hvn"]
script = ExtResource("10_2rjcm")
amount = 3

[sub_resource type="Resource" id="Resource_f7jdt"]
script = ExtResource("1_s8yq1")
text = "The Cryomancer smothers the fire in frost. The keepers flee, dropping their keys."
choices = Array[ExtResource("2_2jvkf")]([SubResource("Resource_ishql")])
on_enter = Array[ExtResource("4_343ob")]([SubResource("Resource_x0hvn")])

[sub_resource type="Resource" id="Resource_gnluh"]
script = ExtResource("2_2jvkf")
label = "Continue"
tags = Array[StringName]([&"Choice.Leave"])

[sub_resource type="Resource" id="Resource_nxjs2"]
