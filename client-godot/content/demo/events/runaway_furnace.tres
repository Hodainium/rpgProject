[sub_resource type="Resource" id="Resource_vpvum"]
script = ExtResource("5_its1l")
page = 2

[sub_resource type="Resource" id="Resource_2gt4p"]
script = ExtResource("2_2jvkf")
label = "Freeze the furnace"
conditions = Array[ExtResource("3_bo4i3")]([SubResource("Resource_dvdc5")])
outcomes = Array[ExtResource("4_343ob")]([SubResource("Resource_vpvum")])
tags = Array[StringName]([&"Choice.Class", &"Choice.Gain.Keys"])
show = 1

[sub_resource type="Resource" id="Resource_recmy"]
script = ExtResource("5_its1l")
page = 3

[sub_resource type="Resource" id="Resource_dygby"]
