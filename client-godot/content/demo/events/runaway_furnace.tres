[sub_resource type="Resource" id="Resource_ypqgm"]
script = ExtResource("1_s8yq1")
text = "You run, but the heat follows you out and scorches everyone on the way."
choices = Array[ExtResource("2_2jvkf")]([SubResource("Resource_gnluh")])
on_enter = Array[ExtResource("4_343ob")]([SubResource("Resource_nxjs2")])

[resource]
