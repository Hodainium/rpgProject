label = "Run"
outcomes = Array[ExtResource("4_343ob")]([SubResource("Resource_recmy")])
tags = Array[StringName]([&"Choice.Cost.Hp"])

[sub_resource type="Resource" id="Resource_hmh2r"]
script = ExtResource("1_s8yq1")
text = "A furnace roars out of control. Its keepers are not friendly."
choices = Array[ExtResource("2_2jvkf")]([SubResource("Resource_2yflf"), SubResource("Resource_2gt4p"), SubResource("Resource_dygby")])

[sub_resource type="Resource" id="Resource_rqcv2"]
script = ExtResource("9_c5qxn")
