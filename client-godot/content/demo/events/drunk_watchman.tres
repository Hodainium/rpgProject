[sub_resource type="Resource" id="Resource_6wbmw"]
script = ExtResource("10_1phui")

[sub_resource type="Resource" id="Resource_invp4"]
script = ExtResource("1_px11q")
text = "You nudge him awake and press ten coins into his hand. He bites one, grunts, and tosses you a key before nodding off again."
choices = Array[ExtResource("2_3nfw1")]([SubResource("Resource_pyk6i")])
on_enter = Array[ExtResource("5_0bxyn")]([SubResource("Resource_6wbmw")])

