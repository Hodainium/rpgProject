[sub_resource type="Resource" id="Resource_5kusu"]
script = ExtResource("1_px11q")
text = "The Bard matches the watchman drink for drink and starts a song. By the third verse he is snoring again, and the party lifts the key ring from his belt."
choices = Array[ExtResource("2_3nfw1")]([SubResource("Resource_wwkft")])
on_enter = Array[ExtResource("5_0bxyn")]([SubResource("Resource_bxa50")])

[sub_resource type="Resource" id="Resource_wahq1"]
