[sub_resource type="Resource" id="Resource_e3sbg"]
script = ExtResource("1_px11q")
text = "A watchman snores on a barrel, a ring of keys on his belt."
choices = Array[ExtResource("2_3nfw1")]([SubResource("Resource_ffmyf"), SubResource("Resource_wdn2t"), SubResource("Resource_kxrnc"), SubResource("Resource_btn58")])

[sub_resource type="Resource" id="Resource_pyk6i"]
