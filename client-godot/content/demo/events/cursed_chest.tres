[sub_resource type="Resource" id="Resource_kriy8"]
script = ExtResource("2_4lsqc")
label = "Leave it"

[sub_resource type="Resource" id="Resource_sooab"]
script = ExtResource("1_w3txt")
text = "A chest bound in black chains. Something inside is worth having; the chains want blood."
choices = Array[ExtResource("2_4lsqc")]([SubResource("Resource_oeelf"), SubResource("Resource_kriy8")])

[resource]
script = ExtResource("9_m6tgc")
id = &"demo.event.cursed_chest"
display_name = "Cursed chest"
