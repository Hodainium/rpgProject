[sub_resource type="Resource" id="Resource_3cxyj"]
script = ExtResource("1_t7npc")
text = "A stone idol with too many eyes. \"Give me the last of you,\" it whispers, \"and the rest grow strong.\""
choices = Array[ExtResource("2_6xoa2")]([SubResource("Resource_yn3uy"), SubResource("Resource_gf75c"), SubResource("Resource_jctj2")])

