[sub_resource type="Resource" id="Resource_6d5w7"]
script = ExtResource("1_t7npc")
text = "The Ember Knight's flames turn the idol to slag. Its eyes were set with silver, which pools on the floor."
choices = Array[ExtResource("2_6xoa2")]([SubResource("Resource_f35vx")])
on_enter = Array[ExtResource("5_jt2ot")]([SubResource("Resource_e4ie4")])

[sub_resource type="Resource" id="Resource_ff306"]
