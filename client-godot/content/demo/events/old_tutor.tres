[sub_resource type="Resource" id="Resource_2671q"]
script = ExtResource("5_hqtb4")

[sub_resource type="Resource" id="Resource_0m5on"]
script = ExtResource("2_0vyne")
label = "Take the lesson (everyone gains a level)"
tags = Array[StringName]([&"Choice.Gain.Level"])
outcomes = Array[ExtResource("4_mca1i")]([SubResource("Resource_2671q"), SubResource("Resource_endgo1")])

[sub_resource type="Resource" id="Resource_vbqw1"]
