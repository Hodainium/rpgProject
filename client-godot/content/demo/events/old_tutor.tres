[sub_resource type="Resource" id="Resource_s3qdg"]
script = ExtResource("2_0vyne")
label = "Take the purse (40 XP each and 10 coins)"
tags = Array[StringName]([&"Choice.Gain.Xp", &"Choice.Gain.Coins"])
outcomes = Array[ExtResource("4_mca1i")]([SubResource("Resource_vbqw1"), SubResource("Resource_ik6s0"), SubResource("Resource_endgo2")])

[sub_resource type="Resource" id="Resource_bc5kt"]
script = ExtResource("2_0vyne")
label = "Leave"
tags = Array[StringName]([&"Choice.Leave"])
outcomes = Array[ExtResource("4_mca1i")]([SubResource("Resource_endgo3")])

[sub_resource type="Resource" id="Resource_qhsg1"]
script = ExtResource("1_nda24")
text = "An old tutor offers a lesson, or a purse for listening."
choices = Array[ExtResource("2_0vyne")]([SubResource("Resource_0m5on"), SubResource("Resource_s3qdg"), SubResource("Resource_bc5kt")])

[sub_resource type="Resource" id="Resource_endcont"]
script = ExtResource("2_0vyne")
label = "Continue"
tags = Array[StringName]([&"Choice.Leave"])

[sub_resource type="Resource" id="Resource_endpage1"]
script = ExtResource("1_nda24")
text = "The old tutor talks for an hour, chalk squeaking on the wall. Somehow it all makes sense, and everyone walks away sharper than they came."
choices = Array[ExtResource("2_0vyne")]([SubResource("Resource_endcont")])

[sub_resource type="Resource" id="Resource_endpage2"]
script = ExtResource("1_nda24")
text = "He presses a small purse into your hands and, while you count it, shares a few hard-won lessons anyway."
choices = Array[ExtResource("2_0vyne")]([SubResource("Resource_endcont")])

[sub_resource type="Resource" id="Resource_endpage3"]
script = ExtResource("1_nda24")
text = "He waves you off, already dozing over his notes."
choices = Array[ExtResource("2_0vyne")]([SubResource("Resource_endcont")])

[resource]
script = ExtResource("8_0asu6")
