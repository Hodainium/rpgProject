[sub_resource type="Resource" id="Resource_volge"]
script = ExtResource("4_7a1i6")
amount = 10

[sub_resource type="Resource" id="Resource_sv2ka"]
script = ExtResource("6_a3ljp")
amount = 10

[sub_resource type="Resource" id="Resource_78rvi"]
script = ExtResource("7_mjxpr")
page = 1

[sub_resource type="Resource" id="Resource_yb4ma"]
script = ExtResource("2_k4dam")
label = "Pay 10 coins"
conditions = Array[ExtResource("3_svmf5")]([SubResource("Resource_volge")])
outcomes = Array[ExtResource("5_f11ec")]([SubResource("Resource_sv2ka"), SubResource("Resource_78rvi")])
tags = Array[StringName]([&"Choice.Cost.Coins", &"Choice.Gain.Reveal"])

[sub_resource type="Resource" id="Resource_r0bow"]
script = ExtResource("4_7a1i6")
amount = 25

[sub_resource type="Resource" id="Resource_rsaox"]
script = ExtResource("6_a3ljp")
amount = 25

[sub_resource type="Resource" id="Resource_dl2e3"]
script = ExtResource("7_mjxpr")
page = 2

[sub_resource type="Resource" id="Resource_2r2df"]
script = ExtResource("2_k4dam")
label = "Pay 25 coins"
conditions = Array[ExtResource("3_svmf5")]([SubResource("Resource_r0bow")])
outcomes = Array[ExtResource("5_f11ec")]([SubResource("Resource_rsaox"), SubResource("Resource_dl2e3")])
tags = Array[StringName]([&"Choice.Cost.Coins", &"Choice.Gain.Reveal", &"Choice.Gain.Keys"])

[sub_resource type="Resource" id="Resource_dwdnq"]
