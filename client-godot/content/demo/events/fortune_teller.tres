[sub_resource type="Resource" id="Resource_q0cmh"]
script = ExtResource("1_x1v2c")
text = "A veiled woman taps a crystal ball. \"Ten coins for the floor. Twenty-five for the floor and a little more.\""
choices = Array[ExtResource("2_k4dam")]([SubResource("Resource_yb4ma"), SubResource("Resource_2r2df"), SubResource("Resource_vklqm"), SubResource("Resource_laaow")])

[sub_resource type="Resource" id="Resource_ev4r7"]
script = ExtResource("2_k4dam")
label = "Continue"
tags = Array[StringName]([&"Choice.Leave"])

[sub_resource type="Resource" id="Resource_h6esc"]
script = ExtResource("10_mbxou")
mode = 1

[sub_resource type="Resource" id="Resource_u2nl4"]
script = ExtResource("1_x1v2c")
text = "She peers into the glass and traces the floor's rooms in the air. The whole floor unfolds in your mind."
choices = Array[ExtResource("2_k4dam")]([SubResource("Resource_ev4r7")])
on_enter = Array[ExtResource("5_f11ec")]([SubResource("Resource_h6esc")])

[sub_resource type="Resource" id="Resource_gan4r"]
script = ExtResource("2_k4dam")
label = "Continue"
tags = Array[StringName]([&"Choice.Leave"])

[sub_resource type="Resource" id="Resource_qlmrm"]
script = ExtResource("10_mbxou")
mode = 1

[sub_resource type="Resource" id="Resource_3rlja"]
script = ExtResource("11_vqfd6")

[sub_resource type="Resource" id="Resource_w51om"]
script = ExtResource("1_x1v2c")
text = "She shows you the floor, then presses a golden key into your palm. \"You'll know the door.\""
choices = Array[ExtResource("2_k4dam")]([SubResource("Resource_gan4r")])
on_enter = Array[ExtResource("5_f11ec")]([SubResource("Resource_qlmrm"), SubResource("Resource_3rlja")])

[sub_resource type="Resource" id="Resource_xiyvw"]
script = ExtResource("2_k4dam")
label = "Continue"
tags = Array[StringName]([&"Choice.Leave"])

[sub_resource type="Resource" id="Resource_oaqim"]
script = ExtResource("10_mbxou")
mode = 1

[sub_resource type="Resource" id="Resource_nb6cr"]
script = ExtResource("11_vqfd6")

[sub_resource type="Resource" id="Resource_whpaj"]
script = ExtResource("1_x1v2c")
text = "The Shatterweaver holds up a shard of their own. The two crystals sing together, the floor shows itself, and the old woman hands over a golden key in awe."
choices = Array[ExtResource("2_k4dam")]([SubResource("Resource_xiyvw")])
on_enter = Array[ExtResource("5_f11ec")]([SubResource("Resource_oaqim"), SubResource("Resource_nb6cr")])

[sub_resource type="Resource" id="Resource_wxl1a"]
script = ExtResource("2_k4dam")
label = "Continue"
tags = Array[StringName]([&"Choice.Leave"])

[sub_resource type="Resource" id="Resource_chafp"]
script = ExtResource("1_x1v2c")
text = "\"The future will find you anyway,\" she says to your back."
choices = Array[ExtResource("2_k4dam")]([SubResource("Resource_wxl1a")])

[resource]
script = ExtResource("12_pkkqi")
id = &"demo.event.fortune_teller"
display_name = "Fortune Teller"
