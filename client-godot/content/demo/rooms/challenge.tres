[gd_resource type="Resource" script_class="RoomDefinition" format=3]

[ext_resource type="Script" path="res://game/defs/room_placement.gd" id="1_chlpl"]
[ext_resource type="Script" path="res://addons/GodotGAS/gameplay_tag/gameplay_tag_query.gd" id="2_chlq"]
[ext_resource type="Script" path="res://game/defs/room_wave.gd" id="3_chlw"]
[ext_resource type="Script" path="res://game/defs/room_definition.gd" id="4_chlr"]

[sub_resource type="Resource" id="Resource_p1"]
script = ExtResource("1_chlpl")
cell = Vector2i(2, 2)

[sub_resource type="Resource" id="Resource_p2"]
script = ExtResource("1_chlpl")
cell = Vector2i(2, 4)
slot = 2

[sub_resource type="Resource" id="Resource_p3"]
script = ExtResource("1_chlpl")
cell = Vector2i(1, 1)
slot = 3

[sub_resource type="Resource" id="Resource_p4"]
script = ExtResource("1_chlpl")
cell = Vector2i(1, 5)
slot = 4

[sub_resource type="Resource" id="Resource_e1"]
script = ExtResource("1_chlpl")
cell = Vector2i(10, 3)
kind = 1

[sub_resource type="Resource" id="Resource_e2"]
script = ExtResource("1_chlpl")
cell = Vector2i(10, 1)
kind = 1
slot = 2

[sub_resource type="Resource" id="Resource_e3"]
script = ExtResource("1_chlpl")
cell = Vector2i(10, 5)
kind = 1
slot = 3

[sub_resource type="Resource" id="Resource_q"]
script = ExtResource("2_chlq")
require_all_tags = Array[StringName]([&"Pool.Treasure"])

[sub_resource type="Resource" id="Resource_reward"]
script = ExtResource("1_chlpl")
cell = Vector2i(6, 3)
kind = 3
item_query = SubResource("Resource_q")

[sub_resource type="Resource" id="Resource_w1"]
script = ExtResource("3_chlw")

[sub_resource type="Resource" id="Resource_w2"]
script = ExtResource("3_chlw")

[sub_resource type="Resource" id="Resource_w3"]
script = ExtResource("3_chlw")

[resource]
script = ExtResource("4_chlr")
id = &"demo.room.challenge"
display_name = "Challenge room"
tags = Array[StringName]([&"Room.Type.Challenge", &"Chapter.Demo"])
content_mode = 5
waves = Array[ExtResource("3_chlw")]([SubResource("Resource_w1"), SubResource("Resource_w2"), SubResource("Resource_w3")])
placements = Array[ExtResource("1_chlpl")]([SubResource("Resource_p1"), SubResource("Resource_p2"), SubResource("Resource_p3"), SubResource("Resource_p4"), SubResource("Resource_e1"), SubResource("Resource_e2"), SubResource("Resource_e3"), SubResource("Resource_reward")])
