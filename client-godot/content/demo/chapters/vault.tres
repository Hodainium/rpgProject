[gd_resource type="Resource" script_class="ChapterDefinition" format=3]

[ext_resource type="Script" path="res://addons/GodotGAS/gameplay_tag/gameplay_tag_query.gd" id="1_b80f0"]
[ext_resource type="Resource" path="res://content/demo/floor_rules/vault.tres" id="2_b4808"]
[ext_resource type="Resource" path="res://content/demo/scaling/descent.tres" id="3_ucbn6"]
[ext_resource type="Script" path="res://game/defs/chapter_definition.gd" id="4_u7cu6"]

[sub_resource type="Resource" id="Resource_xfoyh"]
script = ExtResource("1_b80f0")
require_all_tags = Array[StringName]([&"Encounter.Boss", &"Chapter.Vault"])

[sub_resource type="Resource" id="Resource_towrf"]
script = ExtResource("1_b80f0")
require_all_tags = Array[StringName]([&"Chapter.Vault"])
ignore_tags = Array[StringName]([&"Encounter.Boss"])

[sub_resource type="Resource" id="Resource_2j4tr"]
script = ExtResource("1_b80f0")
