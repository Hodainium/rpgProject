[sub_resource type="Resource" id="Resource_lka10"]
script = ExtResource("1_b80f0")
require_any_tags = Array[StringName]([&"Chapter.Demo", &"Chapter.Vault"])

[resource]
script = ExtResource("4_u7cu6")
id = &"demo.chapter.vault"
display_name = "The Vault"
tags = Array[StringName]([&"Chapter.Vault"])
room_query = SubResource("Resource_lka10")
encounter_query = SubResource("Resource_towrf")
boss_encounter_query = SubResource("Resource_xfoyh")
event_query = SubResource("Resource_2j4tr")
