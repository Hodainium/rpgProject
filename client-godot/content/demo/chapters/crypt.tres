[ext_resource type="Script" path="res://game/defs/chapter_definition.gd" id="4_wpxxl"]

[sub_resource type="Resource" id="Resource_3rdpc"]
script = ExtResource("1_ohs8t")
require_all_tags = Array[StringName]([&"Encounter.Boss", &"Chapter.Crypt"])

[sub_resource type="Resource" id="Resource_n6s0v"]
script = ExtResource("1_ohs8t")
require_all_tags = Array[StringName]([&"Chapter.Crypt"])
ignore_tags = Array[StringName]([&"Encounter.Boss"])

[sub_resource type="Resource" id="Resource_y35ka"]
script = ExtResource("1_ohs8t")
