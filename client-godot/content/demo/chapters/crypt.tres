[gd_resource type="Resource" script_class="ChapterDefinition" format=3]

[ext_resource type="Script" path="res://addons/GodotGAS/gameplay_tag/gameplay_tag_query.gd" id="1_ohs8t"]
[ext_resource type="Resource" path="res://content/demo/floor_rules/crypt.tres" id="2_tmoox"]
