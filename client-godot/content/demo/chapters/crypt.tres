[sub_resource type="Resource" id="Resource_qf5dr"]
script = ExtResource("1_ohs8t")
require_any_tags = Array[StringName]([&"Chapter.Demo", &"Chapter.Crypt"])

[resource]
script = ExtResource("4_wpxxl")
id = &"demo.chapter.crypt"
display_name = "The Crypt"
tags = Array[StringName]([&"Chapter.Crypt"])
room_query = SubResource("Resource_qf5dr")
