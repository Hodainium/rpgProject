[gd_resource type="Resource" script_class="StyleRegistry" format=3]

[ext_resource type="Resource" path="res://presentation/demo/style/style_registry.tres" id="1_base"]
[ext_resource type="Script" path="res://game/view/style_registry.gd" id="2_reg"]
[ext_resource type="Script" path="res://game/view/unit_look.gd" id="3_look"]
[ext_resource type="Script" path="res://game/view/unit_attachment.gd" id="4_att"]
[ext_resource type="Material" path="res://presentation/demo/style/surfaces/toad_spots.tres" id="5_warts"]
[ext_resource type="Resource" path="res://presentation/demo/style/attachments/toad_eyes_v1.tres" id="6_eyes"]
[ext_resource type="Resource" path="res://presentation/demo/style/attachments/throat_sac_spotted.tres" id="7_sac"]
[ext_resource type="Resource" path="res://presentation/demo/style/attachments/toad_tongue.tres" id="8_tongue"]

[sub_resource type="Resource" id="Resource_toad_eyes"]
script = ExtResource("4_att")
shape = ExtResource("6_eyes")
mirror = true

[sub_resource type="Resource" id="Resource_toad_sac"]
script = ExtResource("4_att")
shape = ExtResource("7_sac")
socket = &"Front"

[sub_resource type="Resource" id="Resource_toad_tongue"]
script = ExtResource("4_att")
shape = ExtResource("8_tongue")
socket = &"Front"

[sub_resource type="Resource" id="Resource_toad"]
script = ExtResource("3_look")
attachments = Array[ExtResource("4_att")]([SubResource("Resource_toad_eyes"), SubResource("Resource_toad_sac"), SubResource("Resource_toad_tongue")])
surface = ExtResource("5_warts")

[resource]
script = ExtResource("2_reg")
base = ExtResource("1_base")
looks = Dictionary[StringName, ExtResource("3_look")]({
&"demo.enemy.toad": SubResource("Resource_toad")
})
