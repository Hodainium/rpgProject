[gd_scene format=3]

[ext_resource type="Script" path="res://presentation/demo/sound_board.gd" id="1_board"]
[ext_resource type="AudioStream" path="res://presentation/audio/rtp/Cursor1.wav" id="2_hover"]
[ext_resource type="AudioStream" path="res://presentation/audio/rtp/Decision1.wav" id="3_confirm"]
[ext_resource type="AudioStream" path="res://presentation/audio/rtp/Cancel1.wav" id="4_back"]
[ext_resource type="AudioStream" path="res://presentation/audio/rtp/Buzzer1.wav" id="5_refused"]
[ext_resource type="AudioStream" path="res://presentation/audio/rtp/Item1.wav" id="6_item"]
[ext_resource type="AudioStream" path="res://presentation/audio/rtp/Move.wav" id="7_move"]
[ext_resource type="AudioStream" path="res://presentation/audio/rtp/Combat1.wav" id="8_battle"]
[ext_resource type="AudioStream" path="res://presentation/audio/rtp/Collapse1.wav" id="9_death"]

[node name="SoundBoard" type="Node"]
script = ExtResource("1_board")

[node name="Hover" type="AudioStreamPlayer" parent="."]
stream = ExtResource("2_hover")
volume_db = -8.0

[node name="Confirm" type="AudioStreamPlayer" parent="."]
stream = ExtResource("3_confirm")

[node name="Back" type="AudioStreamPlayer" parent="."]
stream = ExtResource("4_back")

[node name="Refused" type="AudioStreamPlayer" parent="."]
stream = ExtResource("5_refused")

[node name="Item" type="AudioStreamPlayer" parent="."]
stream = ExtResource("6_item")

[node name="Move" type="AudioStreamPlayer" parent="."]
stream = ExtResource("7_move")

[node name="BattleStart" type="AudioStreamPlayer" parent="."]
stream = ExtResource("8_battle")

[node name="Death" type="AudioStreamPlayer" parent="."]
stream = ExtResource("9_death")
