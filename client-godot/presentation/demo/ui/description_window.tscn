[gd_scene format=3]

[ext_resource type="Script" path="res://presentation/demo/ui/description_window.gd" id="1_window"]

[node name="DescriptionWindow" type="PanelContainer"]
custom_minimum_size = Vector2(800, 113)
mouse_filter = 2
theme_type_variation = &"Hint"
script = ExtResource("1_window")

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 4

[node name="Head" type="HBoxContainer" parent="Box"]
layout_mode = 2
mouse_filter = 2

[node name="Name" type="Label" parent="Box/Head"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Title"

[node name="Kind" type="Label" parent="Box/Head"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Caption"

[node name="Text" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3

[node name="Extra" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Gold"
