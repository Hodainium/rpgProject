[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://presentation/demo/ui/settings.gd" id="1_settings"]
[ext_resource type="Script" path="res://game/ui/ui_back_button.gd" id="2_back"]

[node name="Settings" type="CenterContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_settings")
focus_on_activate = NodePath("Panel/Margin/Box/Back")

[node name="Panel" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(360, 0)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="Box" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Panel/Margin/Box"]
layout_mode = 2
theme_type_variation = &"Title"
text = "Settings"

[node name="SpeedRow" type="HBoxContainer" parent="Panel/Margin/Box"]
layout_mode = 2

[node name="SpeedLabel" type="Label" parent="Panel/Margin/Box/SpeedRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Battle speed"

[node name="Speed" type="OptionButton" parent="Panel/Margin/Box/SpeedRow"]
unique_name_in_owner = true
layout_mode = 2

[node name="Skip" type="CheckBox" parent="Panel/Margin/Box"]
unique_name_in_owner = true
layout_mode = 2
text = "Skip battle animations"

[node name="AutoBattle" type="CheckBox" parent="Panel/Margin/Box"]
unique_name_in_owner = true
layout_mode = 2
text = "Start battles on Auto"

[node name="AutoUlts" type="CheckBox" parent="Panel/Margin/Box"]
unique_name_in_owner = true
layout_mode = 2
text = "Auto casts ultimates"

[node name="ServerTitle" type="Label" parent="Panel/Margin/Box"]
layout_mode = 2
theme_type_variation = &"Title"
text = "Server"

[node name="ModeLine" type="Label" parent="Panel/Margin/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 0)
layout_mode = 2
autowrap_mode = 3

[node name="UrlRow" type="HBoxContainer" parent="Panel/Margin/Box"]
layout_mode = 2

[node name="UrlLabel" type="Label" parent="Panel/Margin/Box/UrlRow"]
layout_mode = 2
text = "Url"

[node name="Url" type="LineEdit" parent="Panel/Margin/Box/UrlRow"]
