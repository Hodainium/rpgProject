[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://presentation/demo/ui/main_menu.gd" id="1_menu"]
[ext_resource type="Script" path="res://game/ui/ui_push_button.gd" id="2_push"]
[ext_resource type="PackedScene" path="res://presentation/demo/ui/title_menu.tscn" id="3_title"]
[ext_resource type="PackedScene" path="res://presentation/demo/ui/settings.tscn" id="4_settings"]

[node name="MainMenu" type="CenterContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")
focus_on_activate = NodePath("Panel/Margin/Box/NewRun")

[node name="Panel" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(460, 0)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Box" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Panel/Margin/Box"]
layout_mode = 2
theme_type_variation = &"HeaderLarge"
text = "rpgDemo"
horizontal_alignment = 1

[node name="ContinueRow" type="HBoxContainer" parent="Panel/Margin/Box"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Continue" type="Button" parent="Panel/Margin/Box/ContinueRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Continue"

[node name="Tag" type="Label" parent="Panel/Margin/Box/ContinueRow"]
unique_name_in_owner = true
layout_mode = 2
text = "LOCAL"

[node name="ContinueInfo" type="Label" parent="Panel/Margin/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(412, 0)
layout_mode = 2
autowrap_mode = 3

[node name="DeleteSave" type="Button" parent="Panel/Margin/Box"]
unique_name_in_owner = true
visible = false
layout_mode = 2
text = "Delete save"

[node name="NewRun" type="Button" parent="Panel/Margin/Box"]
unique_name_in_owner = true
layout_mode = 2
text = "New run"
script = ExtResource("2_push")
screen = ExtResource("3_title")

[node name="Settings" type="Button" parent="Panel/Margin/Box"]
layout_mode = 2
text = "Settings"
script = ExtResource("2_push")
screen = ExtResource("4_settings")

[node name="Quit" type="Button" parent="Panel/Margin/Box"]
unique_name_in_owner = true
layout_mode = 2
text = "Quit"

[node name="Error" type="Label" parent="Panel/Margin/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(412, 0)
layout_mode = 2
theme_type_variation = &"Warning"
autowrap_mode = 3

[node name="ModeLine" type="Label" parent="Panel/Margin/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(412, 0)
layout_mode = 2
autowrap_mode = 3
