[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://presentation/demo/ui/stairs_panel.gd" id="1_stairs"]
[ext_resource type="Script" path="res://game/ui/ui_list.gd" id="2_list"]
[ext_resource type="PackedScene" path="res://presentation/demo/ui/action_button.tscn" id="3_button"]

[node name="StairsPanel" type="PanelContainer"]
script = ExtResource("1_stairs")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="Box" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="NextFloor" type="Button" parent="Margin/Box"]
unique_name_in_owner = true
layout_mode = 2
text = "Next floor"

[node name="Routes" type="VBoxContainer" parent="Margin/Box"]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("2_list")
entry_scene = ExtResource("3_button")
