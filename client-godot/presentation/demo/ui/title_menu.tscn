[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://presentation/demo/ui/title_menu.gd" id="1_menu"]
[ext_resource type="Script" path="res://game/ui/ui_list.gd" id="2_list"]
[ext_resource type="PackedScene" path="res://presentation/demo/ui/class_card.tscn" id="3_card"]

[node name="TitleMenu" type="CenterContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")
focus_on_activate = NodePath("Panel/Margin/Box/Start")

[node name="Panel" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(900, 0)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="Box" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Panel/Margin/Box"]
layout_mode = 2
theme_type_variation = &"HeaderLarge"
text = "Run demo"

[node name="ContentRoot" type="OptionButton" parent="Panel/Margin/Box"]
unique_name_in_owner = true
layout_mode = 2

[node name="RunPicker" type="OptionButton" parent="Panel/Margin/Box"]
unique_name_in_owner = true
layout_mode = 2

[node name="PartyLabel" type="Label" parent="Panel/Margin/Box"]
unique_name_in_owner = true
layout_mode = 2
text = "Party (1-4):"

[node name="Classes" type="GridContainer" parent="Panel/Margin/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 6
columns = 2
script = ExtResource("2_list")
entry_scene = ExtResource("3_card")

[node name="SeedRow" type="HBoxContainer" parent="Panel/Margin/Box"]
layout_mode = 2

[node name="SeedLabel" type="Label" parent="Panel/Margin/Box/SeedRow"]
layout_mode = 2
text = "Seed:"

[node name="Seed" type="LineEdit" parent="Panel/Margin/Box/SeedRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "blank = random"

[node name="Random" type="Button" parent="Panel/Margin/Box/SeedRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Random"

[node name="Start" type="Button" parent="Panel/Margin/Box"]
unique_name_in_owner = true
layout_mode = 2
text = "Start run"

[node name="Error" type="Label" parent="Panel/Margin/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(860, 0)
layout_mode = 2
theme_type_variation = &"Warning"
autowrap_mode = 3
