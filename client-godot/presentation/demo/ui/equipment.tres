[gd_resource type="Resource" script_class="GearSet" format=3]

[ext_resource type="Script" path="res://game/ui/gear_set.gd" id="1_set"]
[ext_resource type="Script" path="res://game/ui/gear_column.gd" id="2_column"]

[sub_resource type="Resource" id="weapon"]
script = ExtResource("2_column")
title = "WEAPON"
slot = &"Equipment.Slot.Weapon"

[sub_resource type="Resource" id="item_1"]
script = ExtResource("2_column")
title = "ITEM SLOT"
use_slot = 1

[sub_resource type="Resource" id="item_2"]
script = ExtResource("2_column")
title = "ITEM SLOT 2"
use_slot = 2

[resource]
script = ExtResource("1_set")
title = "EQUIPMENT"
columns = Array[ExtResource("2_column")]([SubResource("weapon"), SubResource("item_1"), SubResource("item_2")])
