[gd_scene format=3]

[ext_resource type="Script" path="res://presentation/demo/ui/turn_order_panel.gd" id="1_panel"]
[ext_resource type="Script" path="res://game/ui/ui_list.gd" id="2_list"]
[ext_resource type="PackedScene" path="res://presentation/demo/ui/turn_card.tscn" id="3_card"]

[node name="TurnOrderPanel" type="VBoxContainer"]
