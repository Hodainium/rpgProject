[gd_scene format=3]

[ext_resource type="Script" path="res://presentation/demo/ui/explore_menu.gd" id="1_menu"]
[ext_resource type="Script" path="res://game/ui/ui_list.gd" id="2_list"]
[ext_resource type="PackedScene" path="res://presentation/demo/ui/list_entry.tscn" id="3_entry"]

[node name="ExploreMenu" type="PanelContainer"]
custom_minimum_size = Vector2(360, 226)
script = ExtResource("1_menu")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 6

[node name="Box" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="Entries" type="VBoxContainer" parent="Margin/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 0
script = ExtResource("2_list")
entry_scene = ExtResource("3_entry")

[node name="Spacer" type="Control" parent="Margin/Box"]
layout_mode = 2
size_flags_vertical = 3

[node name="Gold" type="Label" parent="Margin/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Greyed"
text = "Gold: 0"

[node name="Keys" type="Label" parent="Margin/Box"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"Greyed"
text = "Keys: 0"
