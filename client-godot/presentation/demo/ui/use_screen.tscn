[gd_scene format=3]

[ext_resource type="PackedScene" path="res://presentation/demo/ui/menu_frame.tscn" id="1_frame"]
[ext_resource type="Script" path="res://presentation/demo/ui/use_screen.gd" id="2_use"]
[ext_resource type="Script" path="res://game/ui/ui_list.gd" id="3_list"]
[ext_resource type="PackedScene" path="res://presentation/demo/ui/list_entry.tscn" id="4_entry"]
[ext_resource type="PackedScene" path="res://presentation/demo/ui/member_row.tscn" id="5_row"]

[node name="UseScreen" instance=ExtResource("1_frame")]
script = ExtResource("2_use")

[node name="ListWindow" type="PanelContainer" parent="Content/Stack"]
layout_mode = 2
size_flags_vertical = 3

[node name="Box" type="VBoxContainer" parent="Content/Stack/ListWindow"]
layout_mode = 2

[node name="ListTitle" type="Label" parent="Content/Stack/ListWindow/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Caption"

[node name="Scroll" type="ScrollContainer" parent="Content/Stack/ListWindow/Box"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Pool" type="GridContainer" parent="Content/Stack/ListWindow/Box/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 14
theme_override_constants/v_separation = 4
columns = 2
script = ExtResource("3_list")
entry_scene = ExtResource("4_entry")

[node name="Empty" type="Label" parent="Content/Stack/ListWindow/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Muted"

[node name="Spacer" type="Control" parent="Content/Stack"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

[node name="PartyWindow" type="PanelContainer" parent="Content/Stack"]
layout_mode = 2

[node name="Rows" type="VBoxContainer" parent="Content/Stack/PartyWindow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 2
script = ExtResource("3_list")
entry_scene = ExtResource("5_row")
