[gd_scene format=3]

[ext_resource type="PackedScene" path="res://presentation/demo/ui/menu_frame.tscn" id="1_frame"]
[ext_resource type="Script" path="res://presentation/demo/ui/cards/shop.gd" id="2_shop"]
[ext_resource type="Script" path="res://game/ui/ui_list.gd" id="3_list"]
[ext_resource type="PackedScene" path="res://presentation/demo/ui/cards/shop_offer.tscn" id="4_offer"]

[node name="Shop" instance=ExtResource("1_frame")]
script = ExtResource("2_shop")
focus_on_activate = NodePath("Back")

[node name="Header" type="HBoxContainer" parent="Content/Stack"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Content/Stack/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Title"
text = "Shop"

[node name="Gems" type="Label" parent="Content/Stack/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Gold"
text = "0 gems"

[node name="Scroll" type="ScrollContainer" parent="Content/Stack"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Offers" type="VBoxContainer" parent="Content/Stack/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 16
script = ExtResource("3_list")
entry_scene = ExtResource("4_offer")

[node name="Message" type="Label" parent="Content/Stack"]
unique_name_in_owner = true
visible = false
layout_mode = 2
autowrap_mode = 3
