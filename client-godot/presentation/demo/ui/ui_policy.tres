[ext_resource type="PackedScene" path="res://presentation/demo/ui/battle_callouts.tscn" id="29_callouts"]

[sub_resource type="Resource" id="when_menu"]
script = ExtResource("4_query")
require_all_tags = Array[StringName]([&"UI.State.Menu"])

[sub_resource type="Resource" id="when_run"]
script = ExtResource("4_query")
require_all_tags = Array[StringName]([&"UI.State.Run"])

[sub_resource type="Resource" id="when_end"]
script = ExtResource("4_query")
require_all_tags = Array[StringName]([&"UI.State.End"])

[sub_resource type="Resource" id="when_map"]
script = ExtResource("4_query")
require_all_tags = Array[StringName]([&"UI.State.Run.Map"])

[sub_resource type="Resource" id="when_stairs"]
script = ExtResource("4_query")
require_all_tags = Array[StringName]([&"UI.State.Run.Stairs"])

[sub_resource type="Resource" id="when_pickup"]
script = ExtResource("4_query")
require_all_tags = Array[StringName]([&"UI.State.Run.Pickup"])

[sub_resource type="Resource" id="when_event"]
script = ExtResource("4_query")
require_all_tags = Array[StringName]([&"UI.State.Run.Event"])

[sub_resource type="Resource" id="when_battle"]
script = ExtResource("4_query")
require_all_tags = Array[StringName]([&"UI.State.Run.Battle"])

[sub_resource type="Resource" id="screen_title"]
script = ExtResource("2_rule")
scene = ExtResource("10_title")
layer = &"UI.Layer.Menu"
active_when = SubResource("when_menu")
clears_layer = &"UI.Layer.GameMenu"

[sub_resource type="Resource" id="screen_hud"]
script = ExtResource("2_rule")
scene = ExtResource("11_hud")
layer = &"UI.Layer.Game"
active_when = SubResource("when_run")

[sub_resource type="Resource" id="screen_end"]
script = ExtResource("2_rule")
scene = ExtResource("12_end")
layer = &"UI.Layer.Menu"
active_when = SubResource("when_end")
clears_layer = &"UI.Layer.GameMenu"

[sub_resource type="Resource" id="back_run_menu"]
script = ExtResource("2_rule")
scene = ExtResource("13_run_menu")
layer = &"UI.Layer.GameMenu"
active_when = SubResource("when_map")

[sub_resource type="Resource" id="panel_map"]
script = ExtResource("3_ext")
slot = &"UI.Slot.Hud.Right"
scene = ExtResource("20_map")
active_when = SubResource("when_run")

[sub_resource type="Resource" id="panel_stairs"]
script = ExtResource("3_ext")
slot = &"UI.Slot.Hud.Right"
scene = ExtResource("21_stairs")
order = 10
active_when = SubResource("when_stairs")

[sub_resource type="Resource" id="panel_pickup"]
script = ExtResource("3_ext")
slot = &"UI.Slot.Hud.Right"
scene = ExtResource("22_pickup")
order = 20
active_when = SubResource("when_pickup")

[sub_resource type="Resource" id="panel_party"]
script = ExtResource("3_ext")
slot = &"UI.Slot.Hud.Left"
scene = ExtResource("23_party")
active_when = SubResource("when_run")

[sub_resource type="Resource" id="panel_field"]
script = ExtResource("3_ext")
slot = &"UI.Slot.Hud.Left"
scene = ExtResource("24_field")
order = 10
active_when = SubResource("when_map")

[sub_resource type="Resource" id="panel_event"]
script = ExtResource("3_ext")
slot = &"UI.Slot.Hud.Center"
scene = ExtResource("25_event")
active_when = SubResource("when_event")

[sub_resource type="Resource" id="panel_battle"]
script = ExtResource("3_ext")
slot = &"UI.Slot.Hud.Bottom"
scene = ExtResource("26_battle")
active_when = SubResource("when_battle")

[sub_resource type="Resource" id="panel_card"]
script = ExtResource("3_ext")
slot = &"UI.Slot.Hud.Overlay"
scene = ExtResource("27_card")
active_when = SubResource("when_run")

[sub_resource type="Resource" id="panel_message"]
script = ExtResource("3_ext")
slot = &"UI.Slot.Footer"
scene = ExtResource("28_message")

[sub_resource type="Resource" id="panel_callouts"]
script = ExtResource("3_ext")
slot = &"UI.Slot.Hud.Overlay"
scene = ExtResource("29_callouts")
order = 10
active_when = SubResource("when_battle")

[resource]
script = ExtResource("1_policy")
layout = ExtResource("5_layout")
theme = ExtResource("6_theme")
screens = Array[ExtResource("2_rule")]([SubResource("screen_title"), SubResource("screen_hud"), SubResource("screen_end")])
extensions = Array[ExtResource("3_ext")]([SubResource("panel_map"), SubResource("panel_stairs"), SubResource("panel_pickup"), SubResource("panel_party"), SubResource("panel_field"), SubResource("panel_event"), SubResource("panel_battle"), SubResource("panel_card"), SubResource("panel_message"), SubResource("panel_callouts")])
back_screens = Array[ExtResource("2_rule")]([SubResource("back_run_menu")])
confirm_scene = ExtResource("14_confirm")
