[gd_scene format=3]

[ext_resource type="Script" path="res://presentation/demo/ui/command_panel.gd" id="1_panel"]
[ext_resource type="Script" path="res://game/ui/ui_list.gd" id="2_list"]
[ext_resource type="PackedScene" path="res://presentation/demo/ui/list_entry.tscn" id="3_entry"]

[node name="CommandPanel" type="PanelContainer"]
custom_minimum_size = Vector2(360, 226)
script = ExtResource("1_panel")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 6

[node name="Box" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="TitleRow" type="HBoxContainer" parent="Margin/Box"]
custom_minimum_size = Vector2(0, 28)
layout_mode = 2

[node name="Title" type="Label" parent="Margin/Box/TitleRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Caption"
vertical_alignment = 1

[node name="Back" type="Button" parent="Margin/Box/TitleRow"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"Toggle"
text = "BACK"

[node name="Scroll" type="ScrollContainer" parent="Margin/Box"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Entries" type="VBoxContainer" parent="Margin/Box/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2
script = ExtResource("2_list")
entry_scene = ExtResource("3_entry")

[node name="Footer" type="HBoxContainer" parent="Margin/Box"]
layout_mode = 2
alignment = 2

[node name="Hint" type="Button" parent="Margin/Box/Footer"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Toggle"
toggle_mode = true
text = "HINT ON"

[node name="Auto" type="Button" parent="Margin/Box/Footer"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Toggle"
toggle_mode = true
text = "AUTO"

[node name="Speed" type="Button" parent="Margin/Box/Footer"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Toggle"
text = "SPEED 1×"

[node name="Skip" type="Button" parent="Margin/Box/Footer"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Toggle"
toggle_mode = true
text = "SKIP"
