[sub_resource type="Resource" id="Resource_t4x15"]
script = ExtResource("5_gl75e")
name = &"color"
kind = 3
default_value = Color(0.55, 0.95, 0.35, 1)
description = "Shell colour."

[sub_resource type="Resource" id="Resource_taevv"]
script = ExtResource("5_gl75e")
name = &"intensity"
default_value = 0.9
max_value = 4.0
description = "Brightness."

[sub_resource type="Resource" id="Resource_byx1h"]
script = ExtResource("5_gl75e")
name = &"power"
default_value = 2.0
min_value = 0.5
max_value = 8.0
description = "How thin the rim is."

[sub_resource type="Resource" id="Resource_oojqw"]
script = ExtResource("5_gl75e")
name = &"fill"
default_value = 0.08
max_value = 1.0
description = "How much of the body glows besides the rim."

[sub_resource type="Resource" id="Resource_mhwwx"]
script = ExtResource("5_gl75e")
name = &"grow"
default_value = 0.01
max_value = 0.2
description = "World units the shell is pushed out."

[sub_resource type="Resource" id="Resource_nkoth"]
script = ExtResource("5_gl75e")
name = &"erosion"
default_value = 0.4
max_value = 1.0
description = "How much of the shell the noise eats."

[sub_resource type="Resource" id="Resource_tkums"]
script = ExtResource("5_gl75e")
name = &"noise_scale"
default_value = 5.0
min_value = 0.5
max_value = 20.0
description = "Size of the noise pattern."

[sub_resource type="Resource" id="Resource_b5awy"]
script = ExtResource("5_gl75e")
name = &"scroll"
default_value = 0.5
min_value = -4.0
max_value = 4.0
description = "Noise speed up the body (negative = down)."

[resource]
script = ExtResource("6_a7bwi")
id = &"fx.status_skin"
display_name = "Status skin"
params = Array[ExtResource("5_gl75e")]([SubResource("Resource_t4x15"), SubResource("Resource_taevv"), SubResource("Resource_byx1h"), SubResource("Resource_oojqw"), SubResource("Resource_mhwwx"), SubResource("Resource_nkoth"), SubResource("Resource_tkums"), SubResource("Resource_b5awy")])
