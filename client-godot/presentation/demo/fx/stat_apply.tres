[sub_resource type="Resource" id="Resource_arxns"]
script = ExtResource("9_o0gvk")
name = &"drift"
kind = 5
default_value = Vector3(0, 1.1, 0)
description = "Which way the chevrons move: up for a buff, down for a debuff."

[sub_resource type="Resource" id="Resource_w3xck"]
script = ExtResource("9_o0gvk")
name = &"start"
kind = 5
default_value = Vector3(0, 0, 0)
description = "Where they start, relative to the unit (a debuff starts above)."

[sub_resource type="Resource" id="Resource_e0db2"]
script = ExtResource("9_o0gvk")
name = &"angle"
max_value = 360.0
description = "Turns the chevrons over (180 for a debuff)."

[sub_resource type="Resource" id="Resource_8yqcb"]
script = ExtResource("9_o0gvk")
name = &"intensity"
default_value = 1.0
max_value = 4.0
description = "Flash brightness."

[sub_resource type="Resource" id="Resource_sp3p0"]
script = ExtResource("9_o0gvk")
name = &"depth_bias"
default_value = 0.7
max_value = 4.0
description = "Filled with the unit's radius unless the caller passes one."

[resource]
script = ExtResource("10_prvd8")
id = &"fx.stat_apply"
display_name = "Stat apply"
params = Array[ExtResource("9_o0gvk")]([SubResource("Resource_fwvni"), SubResource("Resource_arxns"), SubResource("Resource_w3xck"), SubResource("Resource_e0db2"), SubResource("Resource_8yqcb"), SubResource("Resource_sp3p0")])
