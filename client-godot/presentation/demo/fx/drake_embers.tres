[gd_resource type="Resource" script_class="FxDefinition" format=3]

[ext_resource type="Script" path="res://game/fx/fx_layer.gd" id="1_layer"]
[ext_resource type="Script" path="res://game/fx/fx_binding.gd" id="2_binding"]
[ext_resource type="Script" path="res://game/fx/layers/fx_particles_3d_layer.gd" id="3_particles"]
[ext_resource type="Script" path="res://game/fx/fx_param.gd" id="4_param"]
[ext_resource type="Script" path="res://game/fx/fx_definition.gd" id="5_def"]

[sub_resource type="Resource" id="Resource_embers_color"]
script = ExtResource("2_binding")
property = "process_material:color"
param = &"color"

[sub_resource type="Gradient" id="Gradient_embers"]
offsets = PackedFloat32Array(0, 0.15, 0.35, 0.55, 1)
colors = PackedColorArray(1, 1, 1, 0, 1, 1, 1, 1, 1, 1, 1, 0.2, 1, 1, 1, 1, 1, 1, 1, 0)

[sub_resource type="Resource" id="Resource_embers"]
script = ExtResource("3_particles")
size_min = 0.04
size_max = 0.08
spread = 25
speed_min = 0.25
speed_max = 0.5
damping = 0.2
emission_ring_radius = 0.55
lifetime = 1.8
explosiveness = 0
gravity = Vector3(0, 0.2, 0)
emission_offset = Vector3(0, -0.35, 0)
amount = 30
color_ramp = SubResource("Gradient_embers")
id = &"embers"
loop = true
bindings = Array[ExtResource("2_binding")]([SubResource("Resource_embers_color")])

[sub_resource type="Resource" id="Resource_param_color"]
script = ExtResource("4_param")
name = &"color"
kind = 3
default_value = Color(1, 0.55, 0.15, 1)
description = "Colour."

[resource]
script = ExtResource("5_def")
id = &"fx.drake_embers"
display_name = "Drake embers"
params = Array[ExtResource("4_param")]([SubResource("Resource_param_color")])
layers = Array[ExtResource("1_layer")]([SubResource("Resource_embers")])
tags = Array[StringName]([&"Fx.Kind.Aura"])
description = "Hot embers and a little smoke rising round a unit (the Hoard Drake's look, Set 4b)."
