[gd_resource type="Resource" script_class="FxDefinition" format=3]

[ext_resource type="Script" path="res://game/fx/fx_layer.gd" id="1_layer"]
[ext_resource type="Script" path="res://game/fx/fx_binding.gd" id="2_binding"]
[ext_resource type="Script" path="res://game/fx/layers/fx_particles_3d_layer.gd" id="3_particles"]
[ext_resource type="Texture2D" path="res://presentation/demo/fx/textures/bubble_sheet.png" id="4_bubble"]
[ext_resource type="Script" path="res://game/fx/fx_param.gd" id="5_param"]
[ext_resource type="Script" path="res://game/fx/fx_definition.gd" id="6_def"]

[sub_resource type="Resource" id="Resource_big_color"]
script = ExtResource("2_binding")
property = "process_material:color"
param = &"color"

[sub_resource type="Resource" id="Resource_big_min"]
script = ExtResource("2_binding")
property = "process_material:scale_min"
param = &"size"
scale = 0.14

[sub_resource type="Resource" id="Resource_big_max"]
script = ExtResource("2_binding")
property = "process_material:scale_max"
param = &"size"
scale = 0.26

[sub_resource type="Gradient" id="Gradient_bubbles"]
offsets = PackedFloat32Array(0, 0.15, 0.8, 1)
colors = PackedColorArray(1, 1, 1, 0, 1, 1, 1, 1, 1, 1, 1, 0.9, 1, 1, 1, 0)

[sub_resource type="Resource" id="Resource_bubbles"]
script = ExtResource("3_particles")
size_min = 0.14
size_max = 0.26
spread = 10.0
speed_min = 0.25
speed_max = 0.55
gravity = Vector3(0, 0.5, 0)
emission_ring_radius = 0.58
emission_offset = Vector3(0, -0.36, 0)
soft_distance = 0.2
amount = 22
lifetime = 1.3
explosiveness = 0.0
color_ramp = SubResource("Gradient_bubbles")
texture = ExtResource("4_bubble")
h_frames = 4
id = &"bubbles"
loop = true
bindings = Array[ExtResource("2_binding")]([SubResource("Resource_big_color"), SubResource("Resource_big_min"), SubResource("Resource_big_max")])

[sub_resource type="Resource" id="Resource_small_color"]
script = ExtResource("2_binding")
property = "process_material:color"
param = &"color"

[sub_resource type="Resource" id="Resource_small"]
script = ExtResource("3_particles")
size_min = 0.05
size_max = 0.1
spread = 20.0
speed_min = 0.4
speed_max = 0.9
gravity = Vector3(0, 0.4, 0)
emission_ring_radius = 0.58
emission_offset = Vector3(0, -0.36, 0)
amount = 14
lifetime = 1.1
explosiveness = 0.0
color_ramp = SubResource("Gradient_bubbles")
texture = ExtResource("4_bubble")
h_frames = 4
id = &"small_bubbles"
loop = true
min_quality = 2
bindings = Array[ExtResource("2_binding")]([SubResource("Resource_small_color")])

[sub_resource type="Resource" id="Resource_color"]
script = ExtResource("5_param")
name = &"color"
kind = 3
default_value = Color(0.45, 0.95, 0.3, 1)
description = "Bubble colour."

[sub_resource type="Resource" id="Resource_size"]
script = ExtResource("5_param")
name = &"size"
default_value = 1.0
min_value = 0.3
max_value = 3.0
description = "Bubble size multiplier."

[resource]
script = ExtResource("6_def")
id = &"fx.bubble_ring"
display_name = "Bubble ring"
params = Array[ExtResource("5_param")]([SubResource("Resource_color"), SubResource("Resource_size")])
layers = Array[ExtResource("1_layer")]([SubResource("Resource_bubbles"), SubResource("Resource_small")])
tags = Array[StringName]([&"Fx.Kind.Aura"])
description = "Green bubbles rising from a ring on the floor around a unit (the Plaguewright's look, spec cube-style 6a)."
