[sub_resource type="Resource" id="Resource_ywvs0"]
script = ExtResource("6_xjmpu")
name = &"color"
kind = 3
default_value = Color(1, 1, 1, 1)
description = "The stat's colour."

[sub_resource type="Resource" id="Resource_oq52o"]
script = ExtResource("6_xjmpu")
name = &"drift"
kind = 5
default_value = Vector3(0, 1.1, 0)
description = "Which way the chevrons move: up for a buff, down for a debuff."

[sub_resource type="Resource" id="Resource_uttvo"]
script = ExtResource("6_xjmpu")
name = &"start"
kind = 5
default_value = Vector3(0, 0, 0)
description = "Where they start, relative to the unit (a debuff starts above)."

[sub_resource type="Resource" id="Resource_efn26"]
script = ExtResource("6_xjmpu")
name = &"angle"
max_value = 360.0
description = "Turns the chevrons over (180 for a debuff)."

[sub_resource type="Resource" id="Resource_ttyii"]
script = ExtResource("6_xjmpu")
name = &"depth_bias"
default_value = 0.7
max_value = 4.0
description = "Filled with the unit's radius unless the caller passes one."

[resource]
script = ExtResource("7_3i87s")
id = &"fx.stat_arrows"
display_name = "Stat arrows"
params = Array[ExtResource("6_xjmpu")]([SubResource("Resource_ywvs0"), SubResource("Resource_oq52o"), SubResource("Resource_uttvo"), SubResource("Resource_efn26"), SubResource("Resource_ttyii")])
