[resource]
script = ExtResource("8_wyxij")
id = &"fx.card_glow"
display_name = "Card glow"
params = Array[ExtResource("7_oopxo")]([SubResource("Resource_31xor"), SubResource("Resource_gkd3p"), SubResource("Resource_ieg0j")])
layers = Array[ExtResource("1_sucep")]([SubResource("Resource_cqm3c"), SubResource("Resource_tavib")])
space = 1
tags = Array[StringName]([&"Fx.Kind.Aura"])
description = "Looping rarity aura for a card (start it on hover, a reveal or the collection). Stop it with a fade."
