[gd_resource type="Resource" script_class="FxDefinition" format=3]

[ext_resource type="Script" path="res://game/fx/fx_layer.gd" id="1_layer"]
[ext_resource type="Script" path="res://game/fx/fx_binding.gd" id="2_binding"]
[ext_resource type="Script" path="res://game/fx/layers/fx_particles_3d_layer.gd" id="3_particles"]
[ext_resource type="Script" path="res://game/fx/fx_param.gd" id="4_param"]
[ext_resource type="Script" path="res://game/fx/fx_definition.gd" id="5_def"]

[sub_resource type="Resource" id="Resource_pull_color"]
script = ExtResource("2_binding")
property = "process_material:color"
param = &"color"

[sub_resource type="Gradient" id="Gradient_pull"]
offsets = PackedFloat32Array(0, 0.3, 0.85, 1)
colors = PackedColorArray(1, 1, 1, 0, 1, 1, 1, 1, 1, 1, 1, 0.6, 1, 1, 1, 0)

[sub_resource type="Resource" id="Resource_pull"]
script = ExtResource("3_particles")
size_min = 0.05
size_max = 0.09
spread = 0
speed_min = 0
speed_max = 0
damping = 0.3
radial_accel = -1.6
emission_ring_radius = 0.95
lifetime = 1.2
explosiveness = 0
gravity = Vector3(0, 0, 0)
amount = 36
color_ramp = SubResource("Gradient_pull")
id = &"pull"
loop = true
bindings = Array[ExtResource("2_binding")]([SubResource("Resource_pull_color")])

[sub_resource type="Resource" id="Resource_param_color"]
script = ExtResource("4_param")
name = &"color"
kind = 3
default_value = Color(0.3, 1, 0.85, 1)
description = "Colour."

[resource]
script = ExtResource("5_def")
id = &"fx.devour_pull"
display_name = "Devour pull"
params = Array[ExtResource("4_param")]([SubResource("Resource_param_color")])
layers = Array[ExtResource("1_layer")]([SubResource("Resource_pull")])
tags = Array[StringName]([&"Fx.Kind.Aura"])
description = "Teal motes drawn in from all round toward a unit (the Void Devourer's look, Set 5b)."
