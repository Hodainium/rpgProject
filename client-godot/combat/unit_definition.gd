## A unit's content definition (spec section 3.1). Filled in by designers in content/, by tests in tests/fixtures/.
@tool
class_name UnitDefinition
extends Resource

## Content id referenced by snapshots and encounters, e.g. &"fixture.unit.striker".
@export var id: StringName = &""
## AttributeSet script (e.g. one generated by the GodotGAS dashboard). Must have HP and SPD.
@export var attribute_set: Script
## Abilities, each a scene whose root is a BattleAbility. Grant order matters for the default enemy brain.
@export var abilities: Array[PackedScene] = []
## Enemies only. Null uses the default EnemyBrain.
@export var brain: EnemyBrain

## Stats as typed, with up to 2 decimals (e.g. {"ATK": 500, "CritRate": 5.25}). Editor-only view of stats_x100.
@export_custom(PROPERTY_HINT_NONE, "", PROPERTY_USAGE_EDITOR) var stats: Dictionary[String, float]:
	get:
		var typed: Dictionary[String, float] = {}
		for attribute_name in stats_x100:
			typed[attribute_name] = Fixed.to_display(stats_x100[attribute_name])
		return typed
	set(typed):
		var stored: Dictionary[String, int] = {}
		for attribute_name in typed:
			if Fixed.has_extra_decimals(typed[attribute_name]):
				push_warning("UnitDefinition '%s': %s keeps only 2 decimals." % [id, attribute_name])
			stored[attribute_name] = Fixed.from_typed(typed[attribute_name])
		stats_x100 = stored

## Saved form of `stats` (×100 whole numbers). Applied with initialize_attribute_overrides.
@export_storage var stats_x100: Dictionary[String, int] = {}
