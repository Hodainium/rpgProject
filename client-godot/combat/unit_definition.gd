## A unit's content definition (spec section 3.1). Filled in by designers in content/, by tests in tests/fixtures/.
@tool
class_name UnitDefinition
extends Resource

## Content id referenced by snapshots and encounters, e.g. &"fixture.unit.striker".
@export var id: StringName = &""
## AttributeSet script (e.g. one generated by the GodotGAS dashboard). Must have HP and SPD.
@export var attribute_set: Script
## Abilities, each a scene whose root is a BattleAbility. Grant order matters for the default enemy brain.
@export var abilities: Array[PackedScene] = []
## Enemies only. Null uses the default EnemyBrain.
@export var brain: EnemyBrain
## Spec game-skeleton: shown in menus and the placeholder screens. Not read by combat.
@export var display_name: String = ""
## Colour of the unit's cube in the placeholder screens. Not read by combat, not in the state hash.
@export var display_color: Color = Color(0.6, 0.6, 0.6)
## Spec animation-sets: the unit's view scene (its root extends UnitAnimator). A path, never a PackedScene, so loading
## a definition (verifier, replays) never loads models or animations. Empty = the game's default view.
@export_file("*.tscn") var view: String = ""
## Loose tags on the unit in v2 battles (e.g. Enemy.Boss), and pool tags for the game.
@export_custom(PROPERTY_HINT_NONE, "gas::tag") var tags: Array[StringName] = []
## The loadout used unless an encounter slot or room placement overrides it.
@export var default_loadout: Loadout
## Spec skill-points D17: abilities gained by level (characters: learned skills, ranks and passives; enemies: secret
## skills at higher levels). Run battles (v2 snapshots) only. Empty: levels grant nothing.
@export var level_skills: Array[LevelSkill] = []

## Stats as typed, with up to 2 decimals (e.g. {"atk": 500, "crit_rate": 5.25}). Editor-only view of stats_x100.
@export_custom(PROPERTY_HINT_NONE, "", PROPERTY_USAGE_EDITOR) var stats: Dictionary[String, float]:
	get:
		var typed: Dictionary[String, float] = {}
		for attribute_name in stats_x100:
			typed[attribute_name] = Fixed.to_display(stats_x100[attribute_name])
		return typed
	set(typed):
		var stored: Dictionary[String, int] = {}
		for attribute_name in typed:
			if Fixed.has_extra_decimals(typed[attribute_name]):
				push_warning("UnitDefinition '%s': %s keeps only 2 decimals." % [id, attribute_name])
			stored[attribute_name] = Fixed.from_typed(typed[attribute_name])
		stats_x100 = stored

## Saved form of `stats` (×100 whole numbers). Applied with initialize_attribute_overrides.
@export_storage var stats_x100: Dictionary[String, int] = {}


## Spec skill-points D17, D24: the level skills reached at `unit_level` ("grant", in table order) and the ability tags
## those rows replace ("replaced"; a replaced ability, even a reached level skill, is not granted).
func level_skills_at(unit_level: int) -> Dictionary:
	var grant: Array[PackedScene] = []
	var replaced: Array[StringName] = []
	for row in level_skills:
		if row != null and row.ability != null and row.level <= unit_level:
			grant.append(row.ability)
			if row.replaces != &"":
				replaced.append(row.replaces)
	return {"grant": grant, "replaced": replaced}
