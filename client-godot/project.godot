; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="rpgDemo"
run/main_scene="res://game/game_main.tscn"
run/main_scene.dev_build="res://game/dev/build_entry.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameplayCueManager="*res://addons/GodotGAS/managers/gameplay_cue_manager.gd"
Dev="*res://game/dev/dev.gd"
Watchdog="*res://game/dev/watchdog.gd"
GameplayMessages="*res://game/messages/gameplay_messages.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="rpgDemo"

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotGAS/plugin.cfg", "res://addons/rpg_dev/plugin.cfg")

[input]

show_floor_info={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194306,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
